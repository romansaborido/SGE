@model Domain.DTOs.PlantaDTO


<h2>Cambiar precio</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.planta.nombre</h4>

        <p>
            <strong>Categoría:</strong> @Model.nombreCategoria
        </p>

        <p>
            <strong>Descripción:</strong><br />
            @Model.planta.descripcion
        </p>

        <p>
            <strong>Precio actual:</strong> @Model.planta.precio €
        </p>

        <hr />

        <!-- FORMULARIO CAMBIAR PRECIO -->
        <form asp-action="Planta" method="post">
            <input type="hidden" name="idPlanta" value="@Model.planta.id" />

            <div class="form-group">
                <label for="nuevoPrecio">Nuevo precio</label>
                <input type="number"
                       class="form-control"
                       id="nuevoPrecio"
                       name="nuevoPrecio"
                       step="0.01"
                       required />
            </div>

            <button type="submit" class="btn btn-primary mt-2">
                Guardar precio
            </button>

            <a asp-action="Index" class="btn btn-secondary mt-2">
                Volver
            </a>
        </form>
    </div>
</div>

